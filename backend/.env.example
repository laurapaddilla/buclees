# Copia este archivo como .env y rellena tus valores.
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=buclees_db
DB_USER=postgres
DB_PASSWORD=

# Cuenta de administradora que crea el seed (npm run seed).
ADMIN_NAME=Buclees
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Autenticación (JWT). Genera el secreto con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
