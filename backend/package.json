{
  "name": "buclees-backend",
  "version": "1.0.0",
  "description": "API de Buclees (Express + PostgreSQL)",
  "main": "src/server.js",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "migrate:status": "node src/db/migrate.js status",
    "migrate:new": "node src/db/migrate.js new",
    "seed": "node src/db/seed.js",
    "seed:charts": "node src/db/update-charts.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
